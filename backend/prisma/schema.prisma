// This is your Prisma schema file for MongoDB
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/prisma-client-custom"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PASSENGER
  PROVIDER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  REFUND_PENDING
}

enum VehicleType {
  BUS
  TEMPO
  TRAVELLER
}

enum ProviderStatus {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum NotificationType {
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  REMINDER
  ALERT
  SYSTEM
  PROMOTION
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

enum FeedbackType {
  BOOKING
  PROVIDER
  ROUTE
  PLATFORM
}

enum AlertType {
  PRICE_DROP
  SEAT_AVAILABLE
  NEW_ROUTE
  DEPARTURE_REMINDER
}

enum AlertStatus {
  ACTIVE
  TRIGGERED
  EXPIRED
  DISABLED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum PromoCodeType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum PromoCodeStatus {
  ACTIVE
  INACTIVE
  EXPIRED
}

model User {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  email           String?
  phone           String
  password        String
  role            UserRole         @default(PASSENGER)
  isActive        Boolean          @default(true)
  // Passenger / contact info for reachability
  address         String?
  city            String?
  state           String?
  pincode         String?
  dateOfBirth     DateTime?
  alternatePhone  String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  bookings        Booking[]
  provider        Provider?
  notifications   Notification[]
  feedbacks       Feedback[]
  priceAlerts     PriceAlert[]
  favoriteRoutes  FavoriteRoute[]
  supportTickets  SupportTicket[]
  ticketReplies   TicketReply[]
  promoCodeUsages PromoCodeUsage[]
  wallet          Wallet?

  @@unique([email])
  @@unique([phone])
  @@index([isActive])
  @@index([name])
  @@index([createdAt])
  @@index([role])
  @@map("users")
}

model TicketReply {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  ticketId  String        @db.ObjectId
  userId    String        @db.ObjectId
  message   String
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  @@index([ticketId])
  @@index([userId])
  @@map("ticket_replies")
}

model Provider {
  id            String         @id @default(auto()) @map("_id") @db.ObjectId
  userId        String         @db.ObjectId
  companyName   String
  contactName   String
  contactPhone  String
  contactEmail  String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  
  // Verification
  status        ProviderStatus @default(PENDING)
  verifiedAt    DateTime?
  verifiedBy    String?        @db.ObjectId // Admin user ID
  
  // Documents
  idProof       String?        // File path/URL
  rcDocuments   String?        // File path/URL
  permit        String?        // File path/URL
  
  // Ratings
  rating        Float          @default(0)
  totalReviews  Int            @default(0)
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles      Vehicle[]
  feedbacks     Feedback[]

  @@unique([userId])
  @@map("providers")
}

model Vehicle {
  id                 String      @id @default(auto()) @map("_id") @db.ObjectId
  providerId         String      @db.ObjectId
  type               VehicleType
  name               String      // e.g., "Volvo AC Sleeper"
  registrationNumber String
  totalSeats         Int
  seatLayout         String      @default("2+2") // "2+2", "2+1", "1+1", "2+3", "sleeper"
  amenities          String[]    // ["AC", "Sleeper", "WiFi", "USB"]
  isActive           Boolean     @default(true)
  deletedAt          DateTime?   // Soft delete
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  // Relations
  provider           Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  routes             Route[]

  @@unique([registrationNumber])
  @@index([providerId])
  @@index([deletedAt])
  @@map("vehicles")
}

model Route {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  vehicleId        String    @db.ObjectId
  fromCity         String
  toCity           String
  intermediateStops String[] // Array of city names
  date             DateTime  // Journey date (Departure Date)
  departureTime    String    // e.g., "10:00 AM"
  arrivalDate      DateTime? // Arrival date (optional, for overnight journeys)
  arrivalTime      String?   // e.g., "2:00 PM"
  price            Float     // Price per seat
  availableSeats   Int       // Current available seats
  totalSeats       Int       // Total seats (copied from vehicle)
  isActive         Boolean   @default(true)
  deletedAt        DateTime? // Soft delete
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  vehicle          Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  bookings         Booking[]
  feedbacks        Feedback[]

  @@index([fromCity, toCity, date, isActive])
  @@index([isActive, date]) // For active routes by date
  @@index([vehicleId])
  @@map("routes")
}

model Booking {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  userId             String        @db.ObjectId
  routeId            String        @db.ObjectId
  seats              Int           // Number of seats booked
  seatNumbers        String[]      // Specific seat numbers if applicable
  totalAmount        Float
  status             BookingStatus @default(PENDING)
  paymentStatus      PaymentStatus @default(PENDING)
  
  // Payment
  paymentId          String?       // Razorpay order ID
  paymentMethod      String?       // "online" | "pay_later"
  
  // Contact
  passengerName      String
  passengerPhone     String
  passengerEmail     String?
  passengerAge       Int?
  passengerGender    String?
  pickupLocation     String?
  dropLocation       String?
  
  // Insurance
  hasInsurance       Boolean       @default(false)
  insuranceAmount    Float?        @default(0)
  
  // Cancellation
  cancelledAt        DateTime?
  cancellationReason String?
  refundAmount       Float?
  
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relations
  user               User          @relation(fields: [userId], references: [id])
  route              Route         @relation(fields: [routeId], references: [id])
  promoCodeUsages    PromoCodeUsage[]
  feedbacks          Feedback[]

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([routeId, status])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([userId])
  @@index([routeId])
  @@map("bookings")
}

model SeatLock {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  routeId     String    @db.ObjectId
  seatNumbers String[]  // Locked seat numbers
  userId      String    @db.ObjectId
  expiresAt   DateTime  // Lock expiry time
  createdAt   DateTime  @default(now())

  @@index([routeId])
  @@index([userId])
  @@map("seat_locks")
}

model Notification {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  userId    String             @db.ObjectId
  type      NotificationType
  title     String
  message   String
  status    NotificationStatus @default(UNREAD)
  link      String?            // Optional action link
  metadata  Json?              // Additional data
  createdAt DateTime           @default(now())
  readAt    DateTime?

  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model Feedback {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  userId    String       @db.ObjectId
  providerId String?     @db.ObjectId
  bookingId String?      @db.ObjectId
  routeId   String?      @db.ObjectId
  type      FeedbackType
  subject   String?
  message   String?
  rating    Int?
  isPublic  Boolean      @default(true)
  adminReply String?
  repliedAt DateTime?
  createdAt DateTime     @default(now())

  user      User         @relation(fields: [userId], references: [id])
  provider  Provider?    @relation(fields: [providerId], references: [id])
  booking   Booking?     @relation(fields: [bookingId], references: [id])
  route     Route?       @relation(fields: [routeId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@index([providerId])
  @@index([bookingId])
  @@index([routeId])
  @@map("feedbacks")
}

model PriceAlert {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  userId      String      @db.ObjectId
  type        AlertType
  fromCity    String
  toCity      String
  targetPrice Float?
  date        DateTime?
  status      AlertStatus @default(ACTIVE)
  createdAt   DateTime    @default(now())
  triggeredAt DateTime?

  user        User        @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("price_alerts")
}

model FavoriteRoute {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  fromCity  String
  toCity    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("favorite_routes")
}

model SupportTicket {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  userId      String         @db.ObjectId
  subject     String?
  message     String?
  category    String?        // Added
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  resolvedAt  DateTime?
  replies     TicketReply[]

  user        User           @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("support_tickets")
}

model PromoCodeUsage {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  promoCodeId    String    @db.ObjectId
  bookingId      String    @db.ObjectId
  discountAmount Float
  usedAt         DateTime  @default(now())
  
  user           User      @relation(fields: [userId], references: [id])
  promoCode      PromoCode @relation(fields: [promoCodeId], references: [id])
  booking        Booking   @relation(fields: [bookingId], references: [id])

  @@index([userId])
  @@index([promoCodeId])
  @@index([bookingId])
  @@map("promo_code_usages")
}

model PromoCode {
  id               String          @id @default(auto()) @map("_id") @db.ObjectId
  code             String          @unique
  description      String?
  type             PromoCodeType
  value            Float           // Amount or Percentage
  minAmount        Float?
  maxDiscount      Float?
  validFrom        DateTime
  validUntil       DateTime
  status           PromoCodeStatus @default(ACTIVE)
  maxUses          Int?
  usedCount        Int             @default(0)
  applicableRoutes String[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  usages           PromoCodeUsage[]

  @@map("promo_codes")
}

model BlogPost {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  content     String
  excerpt     String?
  coverImage  String?
  author      String   // Can be userId or name
  tags        String[]
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("blog_posts")
}

// Feature Flags for safe rollouts
model FeatureFlag {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  enabled     Boolean  @default(false)
  segment     String?  // e.g., "all", "beta", "provider", "admin"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled]) // covers queries filtering by enabled state
  @@map("feature_flags")
}

// Destination cards content managed by Admin
model DestinationContent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  city        String
  state       String
  image       String
  priceLabel  String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
  @@map("destination_content")
}

// Promo Banner Experiments for A/B testing
model PromoExperiment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  variants    String[] // e.g., ["blue-banner", "green-banner"]
  active      Boolean  @default(true)
  segment     String?  // optional audience segment
  startAt     DateTime?
  endAt       DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events      PromoEvent[]

  @@map("promo_experiments")
}

// Events tied to promo experiments (view, click, conversion)
model PromoEvent {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  experimentId   String   @db.ObjectId
  userId         String?  @db.ObjectId
  variant        String
  eventType      String   // "VIEW" | "CLICK" | "CONVERSION"
  route          String?  // optional route or context
  createdAt      DateTime @default(now())

  experiment     PromoExperiment @relation(fields: [experimentId], references: [id])

  @@index([experimentId, eventType])
  @@map("promo_events")
}

// Basic API Metrics for SLA monitoring
model ApiMetric {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  method      String
  url         String
  statusCode  Int
  durationMs  Int
  userId      String?  @db.ObjectId
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("api_metrics")
}

// Global System Settings for Admins
model SystemSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       Json
  description String?
  updatedBy   String?  @db.ObjectId // Admin who last updated
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@map("system_settings")
}

// Audit Logs for tracking Admin Actions
model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  adminId     String   @db.ObjectId
  action      String   // e.g., "UPDATE_BOOKING_STATUS", "VERIFY_PROVIDER"
  entityType  String   // e.g., "Booking", "Provider", "User"
  entityId    String   @db.ObjectId
  details     Json?    // Changes made (old -> new values)
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([adminId, createdAt(sort: Desc)])
  @@index([entityType, entityId])
  @@index([createdAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

// System Access Logs for robust monitoring and security tracking
model AccessLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  userId      String?  @db.ObjectId
  method      String
  url         String
  statusCode  Int
  durationMs  Int
  ipAddress   String?
  userAgent   String?
  device      String?  // e.g., "Mobile", "Desktop"
  os          String?  // e.g., "Windows", "iOS"
  browser     String?  // e.g., "Chrome", "Safari"
  country     String?
  city        String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([method, statusCode])
  @@map("access_logs")
}

// ─── Passenger Wallet System ─────────────────────────────────────────────────

enum WalletTransactionType {
  CREDIT          // Money added (refund, promo, admin credit)
  DEBIT           // Money spent (payment toward booking)
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model Wallet {
  id           String              @id @default(auto()) @map("_id") @db.ObjectId
  userId       String              @db.ObjectId @unique
  balance      Float               @default(0)
  totalCredit  Float               @default(0)
  totalDebit   Float               @default(0)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id          String                  @id @default(auto()) @map("_id") @db.ObjectId
  walletId    String                  @db.ObjectId
  type        WalletTransactionType
  amount      Float
  status      WalletTransactionStatus @default(COMPLETED)
  description String
  bookingId   String?                 @db.ObjectId
  createdAt   DateTime                @default(now())

  wallet      Wallet                  @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("wallet_transactions")
}

// ─── Provider Webhook Subscriptions ──────────────────────────────────────────

model WebhookSubscription {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  providerId  String   @db.ObjectId
  url         String
  secret      String   // HMAC signing secret
  events      String[] // e.g. ["BOOKING_CREATED", "BOOKING_CANCELLED"]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([providerId])
  @@map("webhook_subscriptions")
}

// ─── OTP Phone Login ─────────────────────────────────────────────────────────

model OtpRequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  phone       String   // Target phone number
  otpHash     String   // bcrypt hash of the OTP (never store plain)
  expiresAt   DateTime // OTP valid until
  attempts    Int      @default(0) // Wrong attempt counter (max 3)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
  @@map("otp_requests")
}

// ─── FCM Device Tokens (Push Notifications) ──────────────────────────────────

model FcmToken {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  token     String   @unique // FCM registration token
  device    String?  // "android" | "ios" | "web"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("fcm_tokens")
}

// ─── User Seat Preferences (Smart Recommendation) ────────────────────────────

model SeatPreference {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId @unique
  preferredSide String?  // "window" | "aisle" | "middle"
  preferredRow  String?  // "front" | "middle" | "back"
  avoidLastRow  Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@map("seat_preferences")
}

