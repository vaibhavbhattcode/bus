# ============================================
# BUS BOOKING PLATFORM - ENVIRONMENT CONFIG
# ============================================
# SECURITY WARNING: Never commit actual credentials to version control
# Use environment-specific .env files and add them to .gitignore

# ============================================
# APPLICATION CONFIGURATION
# ============================================
PORT=3000
NODE_ENV=development
APP_NAME="Bus Booking Platform"

# ============================================
# DATABASE - MongoDB (REQUIRED)
# ============================================
# Format: mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority
# SECURITY: Use strong passwords, enable IP whitelist, use separate DB per environment
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bus-booking?retryWrites=true&w=majority"

# ============================================
# JWT AUTHENTICATION (REQUIRED)
# ============================================
# Generate secure secrets using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# SECURITY: Use different secrets for dev/staging/production
# SECURITY: Minimum 64 characters for production
JWT_SECRET="REPLACE_WITH_64_CHAR_RANDOM_STRING"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_STRING"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================
# REDIS - For Seat Locking (REQUIRED)
# ============================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
# SECURITY: Use password in production, enable TLS

# ============================================
# FRONTEND CONFIGURATION (REQUIRED)
# ============================================
# Comma-separated list of allowed origins for CORS
FRONTEND_URL="http://localhost:5173,http://localhost:3001"

# ============================================
# PAYMENT GATEWAY - Razorpay (OPTIONAL)
# ============================================
# Get from: https://dashboard.razorpay.com/app/keys
# SECURITY: Use test keys for development, live keys only in production
# SECURITY: Never expose key_secret in frontend code
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="YOUR_KEY_SECRET"

# ============================================
# EMAIL SERVICE - SMTP (OPTIONAL)
# ============================================
# Gmail: Use App Password from https://myaccount.google.com/apppasswords
# SECURITY: Use app-specific passwords, not account password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"

# ============================================
# FILE UPLOAD (OPTIONAL)
# ============================================
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE=5242880

# ============================================
# SECURITY BEST PRACTICES
# ============================================
# 1. Never commit .env files with real credentials
# 2. Use different secrets for each environment
# 3. Rotate secrets regularly (every 90 days)
# 4. Use secret management services (AWS Secrets Manager, Azure Key Vault)
# 5. Enable MFA on all service accounts
# 6. Monitor for exposed secrets using tools like GitGuardian
# 7. Use environment variables in CI/CD, never hardcode
