# ============================================
# BUS BOOKING PLATFORM - SECURE ENVIRONMENT
# ============================================
# ⚠️  CRITICAL: This file contains PLACEHOLDER values
# ⚠️  Generate your own secure credentials before running
# ⚠️  NEVER commit actual credentials to version control

# ============================================
# QUICK SETUP GUIDE
# ============================================
# 1. Copy this file: cp .env.secure .env
# 2. Generate JWT secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 3. Replace all REPLACE_ME values with actual credentials
# 4. Verify .env is in .gitignore
# 5. Test the application

# ============================================
# APPLICATION
# ============================================
PORT=3000
NODE_ENV=development
APP_NAME="Bus Booking Platform"

# ============================================
# DATABASE - MongoDB Atlas
# ============================================
# 🔒 SECURITY CHECKLIST:
# - Use strong password (16+ chars, mixed case, numbers, symbols)
# - Enable IP whitelist in MongoDB Atlas
# - Use separate databases for dev/staging/production
# - Enable audit logging in production
DATABASE_URL="mongodb+srv://REPLACE_ME_USERNAME:REPLACE_ME_PASSWORD@REPLACE_ME_CLUSTER.mongodb.net/bus-booking?retryWrites=true&w=majority"

# ============================================
# JWT AUTHENTICATION
# ============================================
# 🔒 Generate using: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be 64+ characters for production
JWT_SECRET="REPLACE_ME_WITH_64_CHAR_RANDOM_HEX_STRING"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_SECRET="REPLACE_ME_WITH_DIFFERENT_64_CHAR_RANDOM_HEX_STRING"
JWT_REFRESH_EXPIRES_IN="7d"

# ============================================
# REDIS - Session & Seat Locking
# ============================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
# 🔒 Production: Use password and enable TLS

# ============================================
# FRONTEND CORS
# ============================================
# Comma-separated allowed origins
FRONTEND_URL="http://localhost:5173,http://localhost:3001"

# ============================================
# PAYMENT GATEWAY - Razorpay
# ============================================
# 🔒 Get from: https://dashboard.razorpay.com/app/keys
# Use test keys for development, live keys ONLY in production
RAZORPAY_KEY_ID="rzp_test_REPLACE_ME"
RAZORPAY_KEY_SECRET="REPLACE_ME_SECRET"

# ============================================
# EMAIL - SMTP
# ============================================
# 🔒 Gmail: Use App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"

# ============================================
# FILE UPLOADS
# ============================================
UPLOAD_PATH="./uploads"
MAX_FILE_SIZE=5242880

# ============================================
# 🔐 SECURITY REMINDERS
# ============================================
# ✓ All REPLACE_ME values must be changed
# ✓ Use different secrets per environment
# ✓ Rotate secrets every 90 days
# ✓ Never commit .env to git
# ✓ Use secret management in production (AWS Secrets Manager, etc.)
# ✓ Enable MFA on all service accounts
# ✓ Monitor for exposed secrets (GitGuardian, TruffleHog)
