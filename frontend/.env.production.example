# Production environment variables for Vercel deployment
# ⚠️  Set these in the Vercel dashboard under Settings → Environment Variables
#     Do NOT commit this file with real values.

# Backend API URL (Render deployment URL)
VITE_API_URL=https://busbook-api.onrender.com/api

# Firebase (for push notifications)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
